PORT=5000

# MongoDB Atlas o MongoDB local
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT
# Sustituye por un secreto aleatorio de al menos 64 bytes. No reutilices este ejemplo.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Usuario administrador que tendrá acceso de escritura
ADMIN_NAME=Portfolio Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_this_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=portfolio-projects

# Origen(es) exacto(s) del frontend permitido(s) por CORS, separados por comas.
# En Render, configura CLIENT_URL con el dominio publicado del frontend (sin ruta final).
CLIENT_URL=http://localhost:3000
